# === PostgreSQL (docker-compose) ===
POSTGRES_USER=tochka_db
POSTGRES_PASSWORD=tochka_db
POSTGRES_DB=tochka_db

# === Backend ===
# Внутри compose backend ходит в БД по имени сервиса `db`,
# снаружи (локальный pnpm dev) — по localhost.
DATABASE_URL=postgresql://tochka_db:tochka_db@localhost:5432/tochka_db?schema=public
DATABASE_URL_DOCKER=postgresql://tochka_db:tochka_db@db:5432/tochka_db?schema=public
PORT=3000

# === Webapp (Vite) ===
# URL tRPC-бэкенда, вшивается в бандл на этапе build.
# Для локального запуска и docker dev: http://localhost:3000/trpc
VITE_BACKEND_TRPC_URL=http://localhost:3000/trpc
