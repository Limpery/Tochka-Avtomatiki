DATABASE_URL="postgresql://tochka_db:tochka_db@localhost:5432/tochka_db?schema=public"
PORT=3000
# Секрет для подписи JWT (сгенерируйте: openssl rand -base64 32). Никогда не коммитьте реальное значение.
JWT_SECRET="change-me-in-local-env"
# Время жизни JWT в секундах (604800 = 7 дней).
JWT_EXPIRES_IN_SECONDS="604800"