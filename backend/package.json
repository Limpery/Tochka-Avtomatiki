{
  "name": "@memmemory/backend",
  "private": true,
  "version": "0.0.0",
  "description": "MemMemory backend",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "pmd": "prisma migrate dev",
    "types": "tsc --noEmit --project ./tsconfig.json",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslintcache --ext .ts .",
    "prettify": "prettier --log-level warn --cache --write '{src/**/*,*}.{ts,tsx,js,json,yml,scss}' '!**/{node_modules,dist}/**/*'"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "@trpc/server": "^11.17.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lodash": "^4.18.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.12.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.0",
    "prisma": "^7.9.1"
  }
}
