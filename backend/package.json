{
  "name": "@tochka-avtomatiki/backend",
  "private": true,
  "version": "0.0.0",
  "description": "Tochka Avtomatiki backend",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ts-node-dev --watch ./.env --rs --exit-child ./src/index.ts",
    "start": "node dist/index.js",
    "pmd": "prisma migrate dev",
    "pgc": "prisma generate",
    "types": "tsc --noEmit --project ./tsconfig.json",
    "test": "JWT_SECRET=test-secret-key JWT_EXPIRES_IN_SECONDS=60 tsx --test 'src/**/*.test.ts'",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslintcache --ext .ts .",
    "prettify": "prettier --log-level warn --cache --write '{src/**/*,*}.{ts,tsx,js,json,yml,scss}' '!**/{node_modules,dist}/**/*'",
    "prepare": "pnpm pgc"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.9.1",
    "@trpc/server": "^11.17.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "pg": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.12.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.0",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13"
  }
}
