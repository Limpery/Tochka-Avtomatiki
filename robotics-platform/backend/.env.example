# Строка подключения к PostgreSQL 15+ (используется Prisma CLI и adapter-pg)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/robotics_platform?schema=public

# Порт HTTP-сервера Fastify
PORT=4000

# Секрет для подписи JWT. Минимум 16 символов. Сгенерировать: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-secret-string

# Время жизни JWT в секундах (604800 = 7 дней)
JWT_EXPIRES_IN_SECONDS=604800

# Origin фронтенда для CORS (несколько через запятую)
CORS_ORIGIN=http://localhost:3000

NODE_ENV=development
